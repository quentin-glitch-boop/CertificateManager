{
  "services": {
    "web": {
      "name": "CertificateManager",
      "start": "gunicorn --bind 0.0.0.0:$PORT --workers 2 --timeout 120 app_sqlalchemy:app",
      "build": {
        "dockerfilePath": "./Dockerfile",
        "dockerfileContext": "."
      },
      "env": {
        "FLASK_ENV": "production",
        "DATABASE_URL": "$DATABASE_URL"
      }
    },
    "db": {
      "name": "CertificateManager-DB",
      "type": "postgres",
      "start": "",
      "env": {},
      "plugins": {
        "postgres": {
          "version": "14",
          "username": "postgres",
          "password": "$POSTGRES_PASSWORD"
        }
      }
    }
  },
  "plugins": {},
  "variables": {
    "DATABASE_URL": "$DATABASE_URL",
    "POSTGRES_PASSWORD": "$POSTGRES_PASSWORD",
    "SECRET_KEY": "$SECRET_KEY",
    "UPLOAD_FOLDER": "/app/static/uploads",
    "PORT": "$PORT"
  }
}
